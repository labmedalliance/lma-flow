#!/usr/bin/env bash
#
# FORGE / SHIELD pre-push gate (v2) — see CLAUDE.md "Hard rules" and
# Projekte/Coding/CODING_REGELN.md "Security vor Deployment".
#
# Backstop, NOT a replacement for the manual SHIELD+FORGE audit. It checks
# every commit that the remote does not have yet and aborts the push if
#   - an added line contains a credential, a provider token or a private key,
#   - an added line contains an e-mail address, a hosting server name, a
#     public IP address or a personal local path,
#   - an added line, a commit message or an author/committer address matches
#     the local denylist (real names, domains, hosts, SSH users, own e-mails),
#   - an author or committer address is not a noreply address while it
#     matches the denylist,
#   - a secret-bearing file (.env, *.pem, *.key, credentials.*, id_rsa) is added.
#
# The real values live in a denylist OUTSIDE the repo, one extended regex per
# line (default: ~/.config/forge/denylist.txt, override with FORGE_DENYLIST).
# Exceptions for denylist hits (e.g. a license attribution URL) go into an
# allowlist next to it (~/.config/forge/allowlist.txt, override FORGE_ALLOWLIST),
# matched against "<file>: <added line>". This file never contains real values.
#
# Bypass (only after a careful manual review): git push --no-verify
# Activate (once per clone):                    git config core.hooksPath .githooks

set -uo pipefail

z40="0000000000000000000000000000000000000000"
DENYLIST="${FORGE_DENYLIST:-$HOME/.config/forge/denylist.txt}"
# Optional exceptions for denylist hits, matched against "<file>: <line>" (e.g. license attribution URLs).
ALLOWLIST="${FORGE_ALLOWLIST:-$HOME/.config/forge/allowlist.txt}"
findings=0

CRED_RE='(PASSWORD|PASSWD|SECRET|TOKEN|API_?KEY|AUTH_?KEY)[A-Za-z0-9_]*[[:space:]]*[:=][[:space:]]*("|'"'"')[^"'"'"']{6,}'
TOKEN_RE='(AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|glpat-[A-Za-z0-9_-]{20,}|xox[abpr]-[A-Za-z0-9-]{10,}|sk_live_[A-Za-z0-9]{10,}|sk-ant-[A-Za-z0-9_-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'
CRED_OK_RE='(django-insecure-|example|placeholder|change[-_]?me|replace[-_]?me|dummy|fixme|<your|xxxxx|your[-_]?key|env\(|environ|getenv)'

EMAIL_RE='[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}'
EMAIL_OK_RE='(noreply|no-reply|@example\.|@[a-z0-9.-]*\.example\b|@example\b|@localhost|\.test\b|\.invalid\b|\.local\b|@test\.|@domain\.|git@github\.com|git@gitlab\.com|@[0-9]+x\.(png|jpg|jpeg|svg|webp|gif))'
HOST_RE='\b[a-z0-9-]+(\.[a-z0-9-]+)*\.(uberspace\.de|uber\.space)\b'
HOST_OK_RE='\b(example|manual|u8manual|u8lab|lab|dashboard|www)\.(uberspace\.de|uber\.space)\b|\bexample\.[a-z0-9.-]*uber'
IP_RE='(^|[^0-9.])([0-9]{1,3}\.){3}[0-9]{1,3}([^0-9.]|$)'
IP_OK_RE='(^|[^0-9.])(127\.|0\.0\.0\.0|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.0\.2\.|198\.51\.100\.|203\.0\.113\.|255\.)'
PATH_RE='(/Users/[A-Za-z][A-Za-z0-9._-]*/|/home/[a-z][a-z0-9._-]*/|/var/www/virtual/[a-z][a-z0-9._-]*)'
PATH_OK_RE='(/Users/(USER|you|your-?name|example|x)/|/home/(USER|user|you|youruser|example|runner|linuxbrew|node|app)/|/var/www/virtual/(USER|example))'

FILE_RE='(^|/)(\.env(\.[^.]+)?|credentials\.[^/]+|.*\.pem|.*\.key|id_rsa)$'
EXCLUDE_PATHS=(':(exclude)*.lock' ':(exclude)*package-lock.json' ':(exclude)*.min.js' ':(exclude)*.min.css' ':(exclude)*.map' ':(exclude).githooks/*')

deny_active=0
if [ -r "$DENYLIST" ] && grep -vE '^[[:space:]]*(#|$)' "$DENYLIST" >/dev/null 2>&1; then
  deny_active=1
  DENY_PATTERNS="$(mktemp)"
  ALLOW_PATTERNS="$(mktemp)"
  trap 'rm -f "$DENY_PATTERNS" "$ALLOW_PATTERNS"' EXIT
  grep -vE '^[[:space:]]*(#|$)' "$DENYLIST" > "$DENY_PATTERNS"
  [ -r "$ALLOWLIST" ] && grep -vE '^[[:space:]]*(#|$)' "$ALLOWLIST" > "$ALLOW_PATTERNS"
  [ -s "$ALLOW_PATTERNS" ] || echo '^$' > "$ALLOW_PATTERNS"
fi

report() {  # $1 = message, $2 = offending lines; shows where, cuts the values
  [ -z "$2" ] && return
  echo "✗ pre-push: $1" >&2
  printf '%s\n' "$2" | head -5 | sed -E 's/^(.{0,60}).*/    \1…/' >&2
  findings=1
}

# Lines are prefixed with "<file>: " so the report shows where, but values are cut.
added_lines() {  # $@ = rev-list args
  git log -p --no-color -U0 --format= "$@" -- . "${EXCLUDE_PATHS[@]}" 2>/dev/null \
    | awk '/^\+\+\+ b\//{f=substr($0,7); next} /^\+\+\+ /{next} /^\+/{print f": "substr($0,2)}'
}

check_lines() {  # $1 = label, $2 = lines
  local lines="$2"
  [ -z "$lines" ] && return
  local hit
  hit="$(printf '%s\n' "$lines" | grep -EiI "$CRED_RE" | grep -vEi "$CRED_OK_RE")"
  report "hardcoded credential in $1" "$hit"
  hit="$(printf '%s\n' "$lines" | grep -EI "$TOKEN_RE")"
  report "provider token / private key in $1" "$hit"
  hit="$(printf '%s\n' "$lines" | grep -EiI "$EMAIL_RE" | while IFS= read -r l; do
           printf '%s\n' "$l" | grep -EoiI "$EMAIL_RE" | grep -vEiq "$EMAIL_OK_RE" && printf '%s\n' "$l"
         done)"
  report "e-mail address in $1 (use a noreply or example.com address)" "$hit"
  hit="$(printf '%s\n' "$lines" | grep -EiI "$HOST_RE" | grep -vEi "$HOST_OK_RE")"
  report "hosting server name in $1 (put it into .env)" "$hit"
  hit="$(printf '%s\n' "$lines" | grep -EI "$IP_RE" | grep -vE "$IP_OK_RE")"
  report "public IP address in $1 (put it into .env)" "$hit"
  hit="$(printf '%s\n' "$lines" | grep -EI "$PATH_RE" | grep -vE "$PATH_OK_RE")"
  report "personal local path in $1" "$hit"
  if [ "$deny_active" -eq 1 ]; then
    hit="$(printf '%s\n' "$lines" | grep -EiI -f "$DENY_PATTERNS" | grep -vEi -f "$ALLOW_PATTERNS")"
    report "denylisted value in $1" "$hit"
  fi
}

scan_range() {  # $@ = rev-list args selecting the new commits
  [ -z "$(git rev-list "$@" 2>/dev/null | head -1)" ] && return

  check_lines "added lines" "$(added_lines "$@")"
  check_lines "commit messages" "$(git log --format='%B' "$@")"

  local addrs
  addrs="$(git log --format='%ae%n%ce' "$@" | sort -u)"
  if [ "$deny_active" -eq 1 ]; then
    report "author/committer address is denylisted (set user.email to the noreply address and rewrite)" \
      "$(printf '%s\n' "$addrs" | grep -viE 'noreply' | grep -Eif "$DENY_PATTERNS")"
  fi

  local newfiles
  newfiles="$(git log --no-color --diff-filter=A --name-only --format= "$@" 2>/dev/null | sort -u)"
  report "secret-bearing file added to the repo" \
    "$(printf '%s\n' "$newfiles" | grep -E "$FILE_RE" | grep -vE '\.env\.example$')"
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue                      # branch deletion
  if [ "$remote_sha" = "$z40" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    # New branch (or unknown remote tip, e.g. after a rewrite): every commit
    # that no remote-tracking ref already contains. In a fresh repo: all of them.
    scan_range "$local_sha" --not --remotes
  else
    scan_range "$remote_sha..$local_sha"
  fi
done

if [ "$deny_active" -eq 0 ]; then
  echo "⚠ pre-push: no denylist at $DENYLIST — names, domains and own addresses were NOT checked." >&2
fi

if [ "$findings" -ne 0 ]; then
  echo "" >&2
  echo "Push aborted by the FORGE/SHIELD pre-push gate." >&2
  echo "Move the values into .env or replace them with placeholders, then amend/rewrite." >&2
  echo "Verified false positive only:  git push --no-verify" >&2
  exit 1
fi

echo "→ pre-push: no findings in the new commits." >&2
echo "  Reminder: this is only a backstop — run the full SHIELD+FORGE audit." >&2
exit 0
